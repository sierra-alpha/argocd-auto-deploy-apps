# NOT installed by app-of-apps. Review and pin an implementation commit first.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: warpgate-poc
  namespace: argocd
spec:
  project: default
  destination:
    namespace: warpgate
    server: https://kubernetes.default.svc
  source:
    repoURL: https://github.com/sierra-alpha/argocd-auto-deploy-apps
    targetRevision: REPLACE_WITH_REVIEWED_COMMIT_SHA
    path: warpgate/manifests
  # No automated sync, pruning, deletion finalizer, or setup hook.
  syncPolicy: {}
